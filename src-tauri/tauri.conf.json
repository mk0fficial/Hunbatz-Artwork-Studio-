{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunbatz Studio",
  "version": "1.0.0",
  "identifier": "com.mk0fficial.hunbatzartworkstudio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hunbatz Studio",
        "width": 1600,
        "height": 1200
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
